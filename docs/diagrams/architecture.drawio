<mxfile host="app.diagrams.net" version="29.5.5">
  <diagram name="Page-1" id="otlp-lite-mesh-architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Edge node -->
        <mxCell id="edge" parent="1" vertex="1" value="Edge Node (mobile)&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;instrumented app + mesh exporter&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;strokeColor=#788AA3;fillColor=#FFFFFF;">
          <mxGeometry x="330" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Mesh band -->
        <mxCell id="mesh" parent="1" vertex="1" value="Infrastructure-free wireless mesh&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Wi-Fi Aware · Wi-Fi Direct · Bluetooth LE · LoRa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;dashed=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#393C56;strokeColor=#788AA3;fillColor=#B2C9AB;">
          <mxGeometry x="110" y="210" width="620" height="80" as="geometry" />
        </mxCell>

        <!-- Relay node -->
        <mxCell id="relay" parent="1" vertex="1" value="Relay Node (peer)&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;stores &amp;amp; forwards, never decodes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;strokeColor=#788AA3;fillColor=#FFFFFF;">
          <mxGeometry x="170" y="380" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Gateway node -->
        <mxCell id="gateway" parent="1" vertex="1" value="Gateway Node (leader)&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;mesh radio + cellular / satellite uplink&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;strokeColor=#788AA3;fillColor=#F2CC8F;">
          <mxGeometry x="490" y="380" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Cloud backend -->
        <mxCell id="cloud" parent="1" vertex="1" value="Cloud Backend&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Jaeger · Grafana · Mimir&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;strokeColor=#788AA3;fillColor=#FFFFFF;">
          <mxGeometry x="490" y="540" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Edge -> mesh -->
        <mxCell id="e1" parent="1" edge="1" source="edge" target="mesh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeColor=#788AA3;fontColor=#46495D;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="1" vertex="1" value="OTLP-Lite frames&lt;br&gt;UDP broadcast, no handshake" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=11;">
          <mxGeometry x="430" y="135" width="190" height="40" as="geometry" />
        </mxCell>

        <!-- Mesh -> relay, mesh -> gateway -->
        <mxCell id="e2" parent="1" edge="1" source="mesh" target="relay" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.242;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeColor=#788AA3;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" edge="1" source="mesh" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.758;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeColor=#788AA3;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Relay -> gateway hop -->
        <mxCell id="e4" parent="1" edge="1" source="relay" target="gateway" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeColor=#788AA3;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="1" vertex="1" value="mesh routing hop" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=11;">
          <mxGeometry x="360" y="385" width="120" height="20" as="geometry" />
        </mxCell>

        <!-- Gateway -> cloud -->
        <mxCell id="e5" parent="1" edge="1" source="gateway" target="cloud" style="edgeStyle=orthogonalEdgeStyle;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;strokeColor=#E07A5F;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="1" vertex="1" value="standard OTLP / gRPC over TLS&lt;br&gt;(back to the normal world)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=11;">
          <mxGeometry x="590" y="465" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Footnote -->
        <mxCell id="note" parent="1" vertex="1" value="Only the gateway ever understands OTLP. Edges prune and frame, relays forward blindly." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=11;">
          <mxGeometry x="110" y="620" width="560" height="30" as="geometry" />
        </mxCell>
      </root>
