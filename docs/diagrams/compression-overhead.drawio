          <mxGeometry x="660" y="90" width="60" height="40" as="geometry" />
        </mxCell>

        <!-- Row 2: gzip -->
        <mxCell id="l2" parent="1" vertex="1" value="gzip" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=12;">
