<mxfile host="app.diagrams.net" version="29.5.5">
  <diagram name="Page-1" id="otlp-lite-mesh-sealed-frame">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" vertex="1" value="A sealed frame: what is readable, what is secret, and what the tag protects" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=13;">
          <mxGeometry x="60" y="40" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- Frame row -->
        <mxCell id="hdr" parent="1" vertex="1" value="header&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;24 bytes, clear&lt;br&gt;Flags bit 2 = sealed&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;strokeColor=#788AA3;fillColor=#FFFFFF;">
          <mxGeometry x="60" y="110" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ctr" parent="1" vertex="1" value="counter&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;4 bytes, clear&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;strokeColor=#788AA3;fillColor=#F2CC8F;">
          <mxGeometry x="220" y="110" width="90" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ct" parent="1" vertex="1" value="ciphertext&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;the pruned span, 235 bytes, encrypted&lt;br&gt;looks like random noise&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#393C56;strokeColor=#788AA3;fillColor=#B2C9AB;">
          <mxGeometry x="310" y="110" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tag" parent="1" vertex="1" value="tag&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;16 bytes&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;strokeColor=#E07A5F;fillColor=#FFFFFF;">
          <mxGeometry x="620" y="110" width="90" height="70" as="geometry" />
        </mxCell>
        <mxCell id="total" parent="1" vertex="1" value="279" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=13;fontStyle=1;">
          <mxGeometry x="720" y="110" width="60" height="70" as="geometry" />
        </mxCell>

        <!-- Braces: readable by relays -->
        <mxCell id="b1" parent="1" edge="1" style="endArrow=none;startArrow=none;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;strokeColor=#788AA3;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="200" as="sourcePoint" />
            <mxPoint x="310" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b1t" parent="1" vertex="1" value="readable by anyone, including relays: enough to route the frame and detect replays" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=11;">
          <mxGeometry x="60" y="205" width="250" height="40" as="geometry" />
        </mxCell>

        <!-- Brace: secret -->
        <mxCell id="b2" parent="1" edge="1" style="endArrow=none;startArrow=none;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;strokeColor=#788AA3;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="310" y="200" as="sourcePoint" />
            <mxPoint x="620" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b2t" parent="1" vertex="1" value="secret: only a holder of this node's key can read it" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=11;">
          <mxGeometry x="310" y="205" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- Brace: authenticated (everything) -->
        <mxCell id="b3" parent="1" edge="1" style="endArrow=none;startArrow=none;html=1;rounded=0;sketch=1;hachureGap=4;jiggle=2;curveFitting=1;strokeColor=#E07A5F;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="270" as="sourcePoint" />
            <mxPoint x="620" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b3t" parent="1" vertex="1" value="authenticated by the tag: flip any single byte of the frame and it fails to open. Header included, even though it is not encrypted." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#E07A5F;fontSize=11;">
          <mxGeometry x="60" y="275" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- Key derivation -->
        <mxCell id="keys" parent="1" vertex="1" value="&lt;b&gt;Keys&lt;/b&gt;: one 32-byte master key per mesh. Each node's key = HKDF(master, node ID). The gateway derives any node's key on demand; a captured device gives up only its own.&lt;br&gt;&lt;br&gt;&lt;b&gt;Nonce&lt;/b&gt; (never reused with one key): node ID[0:8] + counter. Unique per node for 4 billion frames." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;fontColor=#46495D;fontSize=11;">
          <mxGeometry x="60" y="330" width="650" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
